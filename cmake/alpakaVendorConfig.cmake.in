@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(alpaka REQUIRED CONFIG)

if(@alpakaV_DEP_FFTW@)
    find_dependency(PkgConfig REQUIRED)
    pkg_check_modules(FFTW3 REQUIRED IMPORTED_TARGET fftw3 fftw3f)
endif()

if(@alpakaV_DEP_CUFFT@)
    find_dependency(CUDAToolkit REQUIRED)
endif()

if(@alpakaV_DEP_ROCFFT@)
    find_dependency(rocfft REQUIRED CONFIG)
endif()

if(@alpakaV_DEP_ONEMKL@)
    find_dependency(MKL REQUIRED CONFIG)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/alpakaVendorTargets.cmake")

if(TARGET alpakaVendor::alpakaVendor)
    set_property(TARGET alpakaVendor::alpakaVendor APPEND PROPERTY INTERFACE_LINK_LIBRARIES alpaka::alpaka)
endif()
